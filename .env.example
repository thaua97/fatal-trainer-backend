NODE_ENV=dev
DATABASE_URL=postgresql://docker:docker@localhost:5432/fatal_trainer
PORT=3333
JWT_SECRET=dev-secret-change-in-production
UPLOAD_DIR=./uploads

# Storage: local (dev) | s3 (AWS)
STORAGE_DRIVER=local

# Obrigatório quando STORAGE_DRIVER=s3
AWS_REGION=
AWS_S3_BUCKET=
CDN_BASE_URL=

# Credenciais IAM (dev local). Em prod, omita e use IAM role da instância/task
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
