generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student            @map("student")
  personal_trainer   @map("personal-trainer")
  admin              @map("admin")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          UserRole
  phone_number  String?
  avatar_url    String?
  city          String?
  state         String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  sessions         Session[]
  favorites        Favorite[]
  trainer          PersonalTrainer?
  trainerReviews   TrainerReview[]
  adminActivities  AdminUserActivity[]
  adminNotes       AdminUserNote[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid())
  token                String   @unique
  user_id              String
  impersonator_user_id String?
  created_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PersonalTrainer {
  id               String   @id
  user_id          String?  @unique
  name             String
  profession       String
  description      String
  photo_url        String
  service_price    Int
  contact_phone    String?
  rating           Float?
  review_count     Int?
  distance_km      Float?
  city             String?
  state            String?
  specialties      String[]
  modalities       String[]
  cref             String?
  gallery          String[]
  availability     String?
  experience_years Int?
  reviews          Json?
  featured         Boolean  @default(false)
  promotion        Json?

  user      User?           @relation(fields: [user_id], references: [id])
  favorites Favorite[]
  reviewsRel TrainerReview[]

  @@map("personal_trainers")
}

model TrainerReview {
  id         String   @id @default(uuid())
  trainer_id String
  user_id    String
  rating     Float
  comment    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  trainer PersonalTrainer @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([trainer_id, user_id])
  @@map("trainer_reviews")
}

model Favorite {
  user_id    String
  trainer_id String

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trainer PersonalTrainer @relation(fields: [trainer_id], references: [id], onDelete: Cascade)

  @@id([user_id, trainer_id])
  @@map("favorites")
}

enum ReportStatus {
  pending
  in_review
  resolved
  archived
}

model Report {
  id            String       @id @default(uuid())
  type          String
  occurred_at   DateTime
  trainer_id    String
  description   String
  contact_email String
  status        ReportStatus @default(pending)
  resolved_at   DateTime?
  resolved_by   String?
  created_at    DateTime     @default(now())

  @@map("reports")
}

model AdminImpersonationLog {
  id             String   @id @default(uuid())
  admin_user_id  String
  target_user_id String
  target_name    String
  target_role    UserRole
  accessed_at    DateTime @default(now())

  @@index([admin_user_id, accessed_at(sort: Desc)])
  @@map("admin_impersonation_logs")
}

model AdminUserActivity {
  id          String    @id @default(uuid())
  user_id     String
  type        String
  title       String
  description String?
  actor_id    String?
  actor_name  String?
  actor_role  UserRole?
  changes     Json?
  metadata    Json?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("admin_user_activities")
}

model AdminUserNote {
  id          String   @id @default(uuid())
  user_id     String
  author_id   String
  author_name String
  content     String
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("admin_user_notes")
}

model PromotionTemplate {
  id               String   @id @default(uuid())
  name             String
  label            String
  discount_percent Int
  starts_at        DateTime @db.Date
  ends_at          DateTime @db.Date
  max_redemptions  Int?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("promotion_templates")
}
